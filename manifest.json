{
  "manifest_version": 3,
  "name": "Pinned Tab Persistence",
  "version": "1.2",
  "description": "Automatically restore pinned tabs across browser sessions",
  "browser_specific_settings": {
    "gecko": {
      "id": "pinned-tabs@ubaiddhiyan.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Pinned Tab Persistence"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
